# Copy to .env and fill in. .env is gitignored, this file is committed.
GEMINI_API_KEY=your_key_here

# Everything below is optional: these are the defaults from src/rag/settings.py.
# Any setting in that file can be overridden here or as a real environment variable.
# PROVIDER=gemini            # or: fake (offline, deterministic, no API calls)
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIM=768          # 768 / 1536 / 3072 for this model
# LLM_MODEL=gemini-3.5-flash     # gemini-2.0-flash was shut down 2026-06-01
# LLM_THINKING_LEVEL=low         # minimal | low | medium | high (Gemini 3 reasons before answering)
# LLM_FALLBACK_MODEL=gemini-3.5-flash-lite  # used only on 429 / 503 / timeout.
#   Verify it with scripts/probe_models.py: a model can be LISTED and still
#   answer 404 for your account (gemini-2.5-flash is closed to new users).
# LLM_MAX_OUTPUT_TOKENS=2048     # covers thinking AND the answer
# LLM_REQUESTS_PER_MINUTE=12     # client side pacing, 0 disables (set it to your quota)
# EMBED_REQUESTS_PER_MINUTE=60
# CHUNK_SIZE=512
# CHUNK_OVERLAP=64
# TOP_K_DENSE=20
# TOP_K_SPARSE=20
# TOP_K_FINAL=5
# FUSION=rrf                 # or: weighted
# RERANKER=none              # or: cross_encoder (needs sentence-transformers)
# VECTOR_BACKEND=numpy       # or: faiss
# MIN_DENSE_SCORE=0.30       # refusal gate, calibrate with scripts/evaluate.py
# LOG_LEVEL=INFO

# --- Deployment ---
# API_KEY=                 # required on /ask and on document upload/delete
# CORS_ORIGINS=https://rag-from-scratch.vercel.app
# CORS_ORIGIN_REGEX=https://rag-from-scratch-[a-z0-9-]+\.vercel\.app
#   Branch deploys get a new subdomain every time, so the exact list only
#   covers production. Keep the regex scoped to this project: a bare
#   https://.*\.vercel\.app lets any site on that platform call the API.
# MAX_UPLOAD_MB=10
# MAX_DOCUMENTS=25
# UPLOADS_PER_HOUR=20
